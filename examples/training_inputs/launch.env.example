# Complete example for scripts/launch_training.sh. Adapt it for each run.
MODEL_NAME=/models/Qwen3.6-27B
TRAIN_LIST=/run-inputs/train-list.yaml
PROMPT_SCHEDULE=/run-inputs/prompt-schedule.yaml
TB_CONFIG=/run-inputs/training.yaml
DATASET_DIR=/workspace/thinkingbox-data/dataset
VLLM_BASE_URL=http://127.0.0.1:8000
MCP_URLS="http://127.0.0.1:7111/mcp http://127.0.0.1:7112/mcp"

NODE_RANK=0
NODE_NPROC=6
NNODES=2
RDZV_ENDPOINT=trainer-node-0:29500
RDZV_ID=qwen36-example
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5

RUN_DIR=checkpoints/qwen36-example
TAG=qwen36-example
MAX_STEPS=20
START_STEP=0
MAX_AGENT_TURNS=20
AGENT=think
N_PROMPTS=12
PROMPT_REPEATS_PER_TASK=1
G=8
CONCURRENCY=12
SP_SIZE=2
MAX_SEQ_LEN=54000
ACTIVATION_OFFLOAD=0
LOGPROB_CHUNK_SIZE=2048
LORA_RANK=16
LORA_ALPHA=32
LORA_TARGET_PROFILE=gdn_hybrid
LR=3e-4
ALGO=grpo
LOSS_AGG_MODE=token-mean
CLIP_LOW=0.2
CLIP_HIGH=0.2
CLIP_C=1000000000
OVERLONG_PENALTY=0
REWARD_FN=binary_test_result
DYNAMIC_SAMPLING_MAX_ROUNDS=0
ROLLOUT_TIMEOUT=3600
SEED=20260819

ROLLOUT_STEP_MAX_RETRIES=1
REQUIRE_CLEAN_ROLLOUT_BATCH=1
ROLLOUT_ALLOW_TIMEOUT_CENSORING=1
MIN_ROLLOUT_COMPLETE_GROUPS=2
MB_EMPTY_MAX_RETRIES=3
MB_CAP=0
MB_TOKEN_BUDGET=0
VLLM_LORA_MODULE_PREFIX=language_model.
VLLM_WRITER_NODE=all
VLLM_HEALTH_URLS=http://127.0.0.1:8000/health
VLLM_HEALTH_MAX_WAIT=1800
SP1_MAX_UPDATE_T=45000
SP_SYNC_CHECK=1
NCCL_PG_TIMEOUT_MIN=120
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Leave both empty for a fresh run. A resumed run requires RESUME_LORA_DIR.
INIT_LORA_DIR=
RESUME_LORA_DIR=
RECOVERY_SOURCE_CHECKPOINT_STEP=
RECOVERY_OPTIMIZER_CHECKPOINT_STEP=

PRODUCER_SOURCE_COMMIT="<source_commit>"
PRODUCER_SOURCE_ARCHIVE_SHA256="<source_archive_sha256>"
PRODUCER_METRIC_SCHEMA=training-metric/v1
PRODUCER_CHECKPOINT_SCHEMA=training-checkpoint/v1
