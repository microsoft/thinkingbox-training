From db20e03b37bb58d48838f61fa861604dccac57c5 Mon Sep 17 00:00:00 2001
From: ThinkingBox Training Maintainers
 <thinkingbox-training@users.noreply.github.com>
Date: Sun, 4 Oct 2026 11:28:51 -0700
Subject: [PATCH 1/3] Fix fused loss with offloaded LM head

---
 verl/utils/kernel/linear_cross_entropy.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/verl/utils/kernel/linear_cross_entropy.py b/verl/utils/kernel/linear_cross_entropy.py
index 84191d7..2085403 100644
--- a/verl/utils/kernel/linear_cross_entropy.py
+++ b/verl/utils/kernel/linear_cross_entropy.py
@@ -74,6 +74,12 @@ class LinearCrossEntropy(torch.autograd.Function):
             if len(labels.shape) != 1:
                 labels = labels.view(-1)
 
+            # FSDP CPU offload may leave the gathered LM-head weight on CPU
+            # while hidden states are on CUDA. The fused kernel requires all
+            # operands on the same device.
+            if weight.device != hidden.device:
+                weight = weight.to(hidden.device, non_blocking=True)
+
             logprobs, entropy, _maximum, _accumulate, _entropy_b = kernels.efficient_entropy_forward(
                 hidden, weight, labels, REDUCTION, temperature, dist_process_group
             )
